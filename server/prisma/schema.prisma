generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  importFileExtension = "ts"
  moduleFormat        = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  email     String   @unique
  password  String
  bcoins    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  paymentHistory PaymentHistory[]
  bounties       Bounty[]
  submissions    Submission[]
  winnings       Winner[]
  bcoinsUsage    BcoinsUsage[]

  @@map("users")
}

model PaymentHistory {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Int
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("payment_history")
}

model Bounty {
  id          Int      @id @default(autoincrement())
  userId      Int
  title       String
  price       Int
  timeLimit   DateTime
  description String
  filePath    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  submissions Submission[]
  winner      Winner?

  @@index([userId])
  @@map("bounties")
}

model Submission {
  id        Int      @id @default(autoincrement())
  userId    Int
  bountyId  Int
  filePath  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  bounty Bounty @relation(fields: [bountyId], references: [id])

  @@index([userId])
  @@index([bountyId])
  @@map("submissions")
}

model Winner {
  id        Int      @id @default(autoincrement())
  bountyId  Int      @unique
  userId    Int
  price     Int
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bounty Bounty @relation(fields: [bountyId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("winners")
}

model BcoinsUsage {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String // "credit" or "debit"
  amount    Int
  reason    String // e.g. "payment", "bounty_posted", "bounty_won", "bounty_refunded"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("bcoins_usage")
}